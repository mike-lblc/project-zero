# ============ СЕКРЕТЫ — НИКОГДА НЕ КОММИТИТЬ ============
.env
.env.*
*.key
*.pem
secrets*
config.local.*

# ============ ДАННЫЕ (регенерируются краулом, не хранить в git) ============
data/*.db
data/*.db-wal
data/*.db-shm
data/*.pid
data/backups/
# 49 МБ, пересоздаётся краулом рынка:
data/bazaar_index.json
# docs/ публикуется через GitHub Pages — датасет нужен в репозитории

# ============ БИНАРНИКИ И ЗАВИСИМОСТИ ============
# cloudflared.exe 53 МБ — качается одной командой:
bin/
node_modules/
service/node_modules/

# ============ PYTHON ============
__pycache__/
*.pyc
.venv/
venv/

# ============ ПРОЧЕЕ ============
reports/*.raw
*.log
data/code_backups/

# 9 МБ, пересоздаётся запросом к DefiLlama раз в шесть часов:
data/defi_protocols.json

# выключатель пульта — локальное решение этой машины, в облако уезжать не должен
data/KILL_SWITCH

# производные файлы: пересоздаются воркером и облачным прогоном
data/registry.json
data/deliveries/

# решение владельца об одной пробной записи в Moltbook — локальное
data/MOLTBOOK_TRUSTED

# AIBTC-подписант: зависимости не в репозиторий
ops/aibtc/node_modules/
data/improver_backup/
